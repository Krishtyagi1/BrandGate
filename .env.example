# Local launcher generates private database credentials in .local/runtime.json.
# Optional external PostgreSQL: use a separate migration owner and NON-superuser runtime role.
# DATABASE_URL=postgresql://inkloom_app:password@127.0.0.1:54329/inkloom
# DATABASE_ADMIN_URL=postgresql://postgres:password@127.0.0.1:54329/inkloom
WEB_ORIGIN=http://127.0.0.1:3000
# Free-only external AI. Keep the real key in the ignored root .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
COOKIE_SECURE=false
